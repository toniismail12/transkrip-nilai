# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transkrip
POSTGRES_PORT=5433
# Karakter khusus pada password WAJIB di-URL-encode: # -> %23, @ -> %40, : -> %3A
DATABASE_URL="postgresql://postgres:changeme@localhost:5433/transkrip?schema=public"

# Opsional — koneksi non-pooler khusus `prisma migrate` (Supabase: port 5432).
# `prisma migrate` tidak bisa lewat transaction pooler (port 6543).
# DIRECT_URL="postgresql://postgres:changeme@localhost:5432/transkrip"

# Auth
JWT_SECRET="generate-a-long-random-secret-here"
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_NAME="transkrip_session"

# Default admin (used by prisma/seed.ts only — change the password after first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456789

NODE_ENV=development
